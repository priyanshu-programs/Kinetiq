# ---- Shared / frontend ----
# Base URL the frontend uses to reach the backend API
VITE_API_URL=http://localhost:8000

# ---- Backend ----
# Comma-separated list of allowed CORS origins (the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign JWT access tokens — generate a long random string
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLAlchemy database URL (SQLite for dev/demo)
DATABASE_URL=sqlite:///./app.db

# ---- LLM (Phase 3, optional) ----
# Free Google Gemini API key; app falls back to rule-based replies if empty
GEMINI_API_KEY=

# ---- IoT / MQTT (Phase 3, optional) ----
MQTT_HOST=localhost
MQTT_PORT=1883
