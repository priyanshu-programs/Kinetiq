# Copy to .env (gitignored) and fill in. Never commit real values.

# ---- Shared / frontend ----
# Base URL the frontend uses to reach the backend API.
# In Vercel, set this to the real Render service URL.
VITE_API_URL=http://localhost:8000

# ---- Backend ----
# "local" tolerates the dev defaults below. "production" fails startup on a
# placeholder JWT secret, a SQLite database, a missing unpooled URL, or a
# localhost CORS origin.
APP_ENV=local

# Comma-separated list of allowed CORS origins (the Vite dev server locally,
# the real Vercel URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign JWT access tokens — generate a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database (Neon PostgreSQL) ----
# Runtime connection: Neon's POOLED string — the host contains "-pooler".
# Neon hands out "postgresql://"; the app rewrites it to the psycopg 3 driver,
# so paste it as given. Keep the ?sslmode=require that Neon includes.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Migrations only: Neon's DIRECT string (same host WITHOUT "-pooler").
# Alembic needs DDL and advisory locks, which transaction pooling can't do.
#   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---- LLM (OpenRouter free models; backend only, never VITE_-prefixed) ----
# Leave empty to run on labelled rule-based replies.
OPENROUTER_API_KEY=
# Verify both ids exist at zero price in https://openrouter.ai/api/v1/models.
# A missing or priced model is refused at startup and chat degrades to basic
# replies — check GET /health ("llm_enabled") to confirm which mode you're in.
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
# Seconds budgeted for the whole primary -> backup chain, not per attempt.
OPENROUTER_TIMEOUT_SECONDS=12
# Calls per UTC day. The free quota is per OpenRouter ACCOUNT, not per user.
OPENROUTER_DAILY_BUDGET=40

# ---- Habits ----
# Skip probability above which a visit creates today's nudge.
NUDGE_RISK_THRESHOLD=0.6

# ---- IoT ----
# Simulated raw sensor readings older than this are pruned.
SENSOR_RETENTION_DAYS=7
